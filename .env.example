# =============================================================================
# TransitIQ — Environment Configuration Template
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
# =============================================================================

# Data & Storage Paths
TRANSITIQ_DATA_DIR=data
TRANSITIQ_RAW_DIR=data/raw
TRANSITIQ_PROCESSED_DIR=data/processed
TRANSITIQ_DUCKDB_PATH=data/processed/transitiq.duckdb
TRANSITIQ_SQLITE_TRACE_PATH=data/processed/traces.sqlite

# Dataset Temporal Scope & Defaults
TRANSITIQ_AS_OF_DATE=2024-12-31
TLC_START_YEAR=2023
TLC_END_YEAR=2024
NOAA_STATION_ID=USW00094728

# LLM Provider Configuration (used starting Week 3)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=
GEMINI_API_KEY=

